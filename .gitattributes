# Auto detect text files and normalize line endings to LF in the repo
* text=auto eol=lf

# Explicit text types
*.html text eol=lf
*.js   text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.css  text eol=lf

# Windows scripts should keep CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf

# Binary files - never touch line endings
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.woff binary
*.woff2 binary
